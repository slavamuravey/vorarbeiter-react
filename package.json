{
  "name": "vorarbeiter-react",
  "version": "2.0.0",
  "homepage": "https://github.com/slavamuravey/vorarbeiter-react",
  "description": "React bindings for Vorarbeiter",
  "source": "src/index.tsx",
  "main": "dist/vorarbeiterreact.cjs.js",
  "umd:main": "dist/vorarbeiterreact.umd.min.js",
  "unpkg": "dist/vorarbeiterreact.umd.min.js",
  "module": "dist/vorarbeiterreact.esm.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vorarbeiterreact.esm.js",
      "require": "./dist/vorarbeiterreact.cjs.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist es",
    "build": "npm run build:es && npm run build:dist && npm run build:types",
    "build:dist": "npm run build:dist:dev && npm run build:dist:prod",
    "build:dist:dev": "rollup -c",
    "build:dist:prod": "rollup -c --environment NODE_ENV:production",
    "build:types": "tsc --project tsconfig.types.json",
    "build:es": "tsc --project tsconfig.es.json",
    "lint": "eslint src/**/* ./*.js --ext .js,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "react",
    "vorarbeiter"
  ],
  "author": {
    "name": "Viacheslav Muravyev",
    "email": "slavamuravey@mail.ru",
    "url": "https://github.com/slavamuravey/vorarbeiter-react"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.21.0"
  },
  "packageManager": "npm@11.20.0",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "rimraf": "^6.1.4",
    "rollup": "^2.79.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "vorarbeiter": ">=8.0.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "src",
    "es",
    "dist"
  ]
}
